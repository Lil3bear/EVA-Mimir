# 复用已装好 Python 依赖的 amd64 基础镜像，覆盖为当前版本代码。
# 避免 pip 下载 wheels 的网络不稳定问题。
FROM eva-mimir-solver:amd64-hosted

ENV LLM_BASE_URL=https://api.deepseek.com/v1 \
    LLM_API_KEY=YOUR_LLM_API_KEY \
    LLM_MODEL=deepseek-v4-flash \
    LLM_GATEWAY=1

# 清掉旧代码，覆盖为当前工作树代码（含分层状态/lineage/claim/artifact 等新模块）
RUN rm -rf /opt/ctf-agent/solver /opt/ctf-agent/shared \
           /opt/ctf-agent/prompts /opt/ctf-agent/skills /skills

COPY solver/ /opt/ctf-agent/solver/
COPY shared/ /opt/ctf-agent/shared/
COPY prompts/ /opt/ctf-agent/prompts/
COPY skills/ /opt/ctf-agent/skills/

RUN ln -sf /opt/ctf-agent/skills /skills

WORKDIR /root/workspace
CMD ["python3", "/opt/ctf-agent/solver/main.py"]
