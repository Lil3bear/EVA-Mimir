FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY index.html ./
COPY src ./src
COPY public ./public
RUN npm run build

FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY server ./server
COPY deploy/run-team-bridge.mjs ./deploy/run-team-bridge.mjs
COPY --from=build /app/dist ./dist
USER node
EXPOSE 4318
CMD ["node","deploy/run-team-bridge.mjs","--remote"]
