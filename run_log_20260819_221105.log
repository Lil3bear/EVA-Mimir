application/json\" \\\n  --data-binary \"$enc\" -w \"\\nHTTP %{http_code}\\n\"\n\necho \"\"\necho \"=== Reload and count contacts after tests ===\"\ncurl -s -c /tmp/sess_g28.jar -b /tmp/sess_g28.jar \"$CUURL/\" | grep -c 'bg-white p-4 rounded shadow'"}, "call_id": "call_00_Srg0fa2FYak2aqkoa9Ot9837"}}
