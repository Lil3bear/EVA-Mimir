{"type": "tool_call", "data": {"tool": "bash", "args": {"cmd": "cd /tmp/home_extract; python3 << 'EOF'\n# 提取完整 encoded powershell 命令（从tag到C2流结束），解码UTF16LE\nimport struct,re,base64\nraw=open('capture.pcap','rb').read()\no=0; frames=[]\nwhile o < len(raw)-4:\n    btype=struct.unpack('<I',raw[o:o+4])[0]\n    blen=struct.unpack('<I',raw[o+4:o+8])[0]\n    if btype==0x00000006:\n        iface,tsh,tsl,cap,orig=struct.unpack('<IIIII',raw[o+8:o+28])\n        pkt=raw[o+28:o+28+cap]; frames.append(pkt)\n    if blen<28 or o+blen>len(raw): break\n    o+=blen\ndef b2ip(b): return f\"{b[0]}.{b[1]}.{b[2]}.{b[3]}\"\nstreams=collections.defaultdict(list)\nfor pkt in frames:\n    if len(pkt)<14: continue\n    et=struct.unpack('>H',pkt[12:14])[0]\n    if et!=0x0800: continue\n    ip=pkt[14:]\n    if ip[9]!=6: continue\n    ihl=(ip[0]&0xf)*4\n    if len(ip)<ihl: continue\n    t=ip[ihl:]\n    if len(t)<20: continue\n    sp,dp=struct.unpack('>HH',t[:4]); seq=struct.unpack('>I',t[4:8])[0]\n    thl=((t[12]>>4)&0xf)*4\n    streams[(b2ip(ip[12:16]),sp,b2ip(ip[16:20]),dp)].append((seq,t[thl:]))\n# C2 1234->49680 流\nkey=('10.10.10.21',1234,'10.10.10.22',49680)\nsegs=sorted(streams[key],key=lambda x:x[0])\ndata=b''.join(p for _,p in segs)\n# 找到 powershell.exe -encoded 后的全部\nm=re.search(rb'powershell\\.exe -encoded \"?([A-Za-z0-9+/=]+)\"?', data)\nprint(\"match:\",bool(m))\nenc=m.group(1)\n# 可能结尾分片被截断, 尝试补=对齐\nenc=enc.replace(b'\\r',b'').replace(b'\\n',b'')\nenc=enc+b'='*((-len(enc))%4)\ntry:\n    cmd=base64.b64decode(enc)\n    print(\"decoded len\",len(cmd))\n    txt=cmd.decode('utf-16-le',errors='replace')\n    open('task_script.txt','w').write(txt)\n    print(txt[:3000])\nexcept Exception as e:\n    print(\"err\",e)\n    # fallback\n    cmd2=base64.b64decode(data[data.find(b'CgAo'):data.find(b'CgAo')+15000].replace(b'\\r\\n',b''))\n    print(cmd2.decode('utf-16-le',errors='replace')[:2000])\nEOF"}, "call_id": "call_00_aXsUceZxzhamBbZgU0kU4256"}}
