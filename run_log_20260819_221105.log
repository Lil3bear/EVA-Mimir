t=401: {\"error\":\"can only concatenate str (not \\\"list\\\") to str\",\"message\":\"JWT token verification failed.\"\n[alg-array-none] NOSIG st=401: {\"error\":\"not enough values to unpack (expected 3, got 2)\",\"message\":\"JWT token \n[alg-cap-nNone] sig"}}
