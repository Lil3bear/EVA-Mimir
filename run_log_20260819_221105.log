{"type": "tool_call", "data": {"tool": "bash", "args": {"cmd": "cd /tmp/home_extract; python3 << 'EOF'\n# Observer方向: 逐TCP流提取全部可打印ASCII明文(HTTP/ActiveMQ/PowerShell)，找前两段flag\nimport struct,re\nraw=open('capture.pcap','rb').read()\no=0\nframes=[]\nwhile o < len(raw)-4:\n    btype=struct.unpack('<I',raw[o:o+4])[0]\n    blen=struct.unpack('<I',raw[o+4:o+8])[0]\n    if btype==0x00000006:\n        iface,tsh,tsl,cap,orig=struct.unpack('<IIIII',raw[o+8:o+28])\n        pkt=raw[o+28:o+28+cap]\n        frames.append(pkt)\n    if blen<28 or o+blen>len(raw): break\n    o+=blen\n\n# 重组所有TCP流(payload排序), 打印可打印ASCII明文\nimport collections\nstreams=collections.defaultdict(list)\ndef b2ip(b): return f\"{b[0]}.{b[1]}.{b[2]}.{b[3]}\"\nfor pkt in frames:\n    if len(pkt)<14: continue\n    et=struct.unpack('>H',pkt[12:14])[0]\n    if et!=0x0800: continue\n    ip=pkt[14:]\n    if len(ip)<20: continue\n    if ip[9]!=6: continue\n    ihl=(ip[0]&0xf)*4\n    t=ip[ihl:]\n    if len(t)<20: continue\n    sp,dp=struct.unpack('>HH',t[:4]); seq=struct.unpack('>I',t[4:8])[0]\n    thl=((t[12]>>4)&0xf)*4\n    src=b2ip(ip[12:16]); dst=b2ip(ip[16:20])\n    streams[(src,sp,dst,dp)].append((seq,t[thl:]))\n\n# 对每个流按seq排序拼接，提取ASCII明文，检查HTB/HTTP/flag片段\nfor (src,sp,dst,dp),segs in streams.items():\n    segs.sort(key=lambda x:x[0])\n    data=b''.join(p for _,p in segs)\n    # 提取可打印长串\n    txt=data.decode('latin-1')\n    printable=re.findall(r'[ -~\\t\\r\\n]{20,}', txt)\n    interesting=[]\n    for p in printable:\n        if re.search(r'HTB|flag|GET /|POST |HTTP/1|Content-|TaskName|part|th flag|{\"|power', p, re.I):\n            interesting.append(p)\n    if interesting or 'HTB' in txt or 'flag' in txt.lower():\n        print(f\"\\n===== STREAM {src}:{sp} -> {dst}:{dp} (total {len(data)}B) =====\")\n        for p in interesting[:30]:\n            print(repr(p[:400]))\nEOF"}, "call_id": "call_00_QiEerv3X0oOHkkA9jrfk4800"}}
