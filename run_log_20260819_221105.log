{"type": "tool_call", "data": {"tool": "bash", "args": {"cmd": "cd /tmp/home_extract; python3 << 'EOF'\n# Observer: 从C2明文流提取UTF-16宽字符串, 搜索flag片段\nimport struct,re,collections\nraw=open('capture.pcap','rb').read()\no=0; frames=[]\nwhile o < len(raw)-4:\n    btype=struct.unpack('<I',raw[o:o+4])[0]\n    blen=struct.unpack('<I',raw[o+4:o+8])[0]\n    if btype==0x00000006:\n        iface,tsh,tsl,cap,orig=struct.unpack('<IIIII',raw[o+8:o+28])\n        pkt=raw[o+28:o+28+cap]; frames.append(pkt)\n    if blen<28 or o+blen>len(raw): break\n    o+=blen\ndef b2ip(b): return f\"{b[0]}.{b[1]}.{b[2]}.{b[3]}\"\nstreams=collections.defaultdict(list)\nfor pkt in frames:\n    if len(pkt)<14: continue\n    et=struct.unpack('>H',pkt[12:14])[0]\n    if et!=0x0800: continue\n    ip=pkt[14:]\n    if ip[9]!=6: continue\n    ihl=(ip[0]&0xf)*4\n    if len(ip)<ihl: continue\n    t=ip[ihl:]\n    if len(t)<20: continue\n    sp,dp=struct.unpack('>HH',t[:4]); seq=struct.unpack('>I',t[4:8])[0]\n    thl=((t[12]>>4)&0xf)*4\n    streams[(b2ip(ip[12:16]),sp,b2ip(ip[16:20]),dp)].append((seq,t[thl:]))\nfor k,segs in streams.items():\n    segs.sort(key=lambda x:x[0])\n    data=b''.join(p for _,p in segs)\n    # UTF16-LE decode and find all readable runs\n    u=data.decode('utf-16-le',errors='replace')\n    word=''\n    for ch in u:\n        if '\\x20'<=ch<='\\x7e':\n            word+=ch\n        else:\n            if len(word)>=3:\n                print(f\"[{k[0]}:{k[1]}->{k[2]}:{k[3]}] {word!r}\")\n            word=''\n    if len(word)>=3:\n        print(f\"[{k[0]}:{k[1]}->{k[2]}:{k[3]}] {word!r}\")\nEOF"}, "call_id": "call_00_eAmFpUX6E3sDwKzm0MtZ3322"}}
