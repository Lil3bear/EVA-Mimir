{"type": "tool_call", "data": {"tool": "bash", "args": {"cmd": "cd /tmp/home_extract; python3 << 'EOF'\n# PCAPNG parse: 提取所有 EPB(0x06) 的 packet data，重组TCP流\nimport struct\nraw=open('capture.pcap','rb').read()\no=0\nframes=[]\nwhile o < len(raw)-4:\n    btype=struct.unpack('<I',raw[o:o+4])[0]\n    blen=struct.unpack('<I',raw[o+4:o+8])[0]\n    if btype==0x00000006:  # EPB\n        # EPB: interface_id(4)+ts_high(4)+ts_low(4)+caplen(4)+origlen(4)+packet_data\n        iface,tsh,tsl,cap,orig=struct.unpack('<IIIII',raw[o+8:o+28])\n        pkt=raw[o+28:o+28+cap]\n        frames.append((o,pkt))\n    if blen<28 or o+blen>len(raw): break\n    o+=blen\nprint(\"total EPB frames\",len(frames))\n\n# 重组TCP流（Ethernet linktype, 试linktype=1）\nimport collections\nstreams={}\ndef bytes_to_ip(b): return f\"{b[0]}.{b[1]}.{b[2]}.{b[3]}\"\n# linktype找IDB\n# 提取每个frame的IP/TCP payload\ntcp_frames=[]\nfor off,pkt in frames:\n    if len(pkt)<14: continue\n    eth=pkt[:14]\n    ethertype=struct.unpack('>H',eth[12:14])[0]\n    if ethertype!=0x0800: \n        tcp_frames.append((off,None))\n        continue\n    ip=pkt[14:]\n    if len(ip)<20: continue\n    proto=ip[9]\n    if proto!=6:\n        tcp_frames.append((off,None)); continue\n    ihl=(ip[0]&0xf)*4\n    tcphdr=ip[ihl:]\n    if len(tcphdr)<20: continue\n    sport,dport=struct.unpack('>HH',tcphdr[:4])\n    seq=struct.unpack('>I',tcphdr[4:8])[0]\n    flags=tcphdr[13]\n    thlen=((tcphdr[12]>>4)&0xf)*4\n    payload=tcphdr[thlen:]\n    src=bytes_to_ip(ip[12:16]); dst=bytes_to_ip(ip[16:20])\n    stream_key=(src,sport,dst,dport)\n    streams.setdefault(stream_key,[]).append((seq,payload,flags,off))\n    tcp_frames.append((off,(src,sport,dst,dport,payload,seq,flags)))\nprint(\"tcp streams:\",len(streams))\nfor k,v in streams.items():\n    v.sort(key=lambda x:(x[0],x[3]))\n    print(\"\\n=== STREAM\",k,\"===\")\n    for seq,pay,fl,off in v:\n        # print printable payload, direction\n        txt=pay.decode('latin-1',errors='replace')\n        printable=txt if all(32<=ord(c)<127 or c in '\\r\\n\\t' for c in txt) else repr(txt[:80])\n        print(f\"  off={off} seq={seq} flags={fl:02x} dir={k[0]} len={len(pay)}: {printable[:300]}\")\nEOF"}, "call_id": "call_00_bBQtsTozwFfFkQQlHhjR8013"}}
