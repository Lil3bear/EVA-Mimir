{"type": "tool_call", "data": {"tool": "bash", "args": {"cmd": "cd /tmp/home_extract; python3 << 'EOF'\nimport struct,re,base64,collections\nraw=open('capture.pcap','rb').read()\n# 解析pcap (不是pcapng)\n# 检查magic\nprint(\"magic\",raw[:4].hex())\n# classic pcap: 24B global header, then per-packet 16B records\nif raw[:4] in (b'\\xd4\\xc3\\xb2\\xa1', b'\\xa1\\xb2\\xc3\\xd4'):\n    o=24; frames=[]; endian='<'\n    if raw[:4]==b'\\xd4\\xc3\\xb2\\xa1': endian='<'\n    else: endian='>'\n    while o+16<=len(raw):\n        ts1,ts2,caplen,origlen=struct.unpack(endian+'IIII',raw[o:o+16])\n        o+=16; frames.append(raw[o:o+caplen]); o+=caplen\n    print(\"frames\",len(frames),\"endian\",endian)\nelse:\n    # pcapng\n    o=0; frames=[]\n    while o < len(raw)-4:\n        btype=struct.unpack('<I',raw[o:o+4])[0]\n        blen=struct.unpack('<I',raw[o+4:o+8])[0]\n        if btype==0x00000006:\n            iface,tsh,tsl,cap,orig=struct.unpack('<IIIII',raw[o+8:o+28])\n            pkt=raw[o+28:o+28+cap]; frames.append(pkt)\n        if blen<28 or o+blen>len(raw): break\n        o+=blen\n    print(\"frames\",len(frames))\ndef b2ip(b): return f\"{b[0]}.{b[1]}.{b[2]}.{b[3]}\"\nstreams=collections.defaultdict(list)\nfor pkt in frames:\n    if len(pkt)<14: continue\n    et=struct.unpack('>H',pkt[12:14])[0]\n    if et!=0x0800: continue\n    ip=pkt[14:]\n    if ip[9]!=6: continue\n    ihl=(ip[0]&0xf)*4\n    if len(ip)<ihl: continue\n    t=ip[ihl:]\n    if len(t)<20: continue\n    sp,dp=struct.unpack('>HH',t[:4]); seq=struct.unpack('>I',t[4:8])[0]\n    thl=((t[12]>>4)&0xf)*4\n    streams[(b2ip(ip[12:16]),sp,b2ip(ip[16:20]),dp)].append((seq,t[thl:]))\n\n# 对DNS/HTTP以外的未加密C2（ActiveMQ以外的其它端口？1234 C2）\n# 只关注C2端口1234和可能下发命令的明文流。提取所有 UTF-16LE 可读串（含零字节的宽字符串）\nfor (sk,sp,dk,dp),segs in streams.items():\n    if sp==1234 or dp==1234 or sp==49680 or dp==49680:\n        segs.sort(key=lambda x:x[0])\n        data=b''.join(p for _,p in segs)\n        print(f\"\\n===== {sk}:{sp}->{dk}:{dp} ({len(data)}B) =====\")\n        # UTF-16LE 宽字符串: 字节对 (chr,0) 形式\n        u=data.decode('utf-16-le',errors='replace')\n        found=False\n        for w in re.findall(r'[\\x20-\\x7e]{3,160}',u):\n            if not isinstance(w,str): continue\n            found=True\n            print(\"  W:\",repr(w))\n        if not found:\n            print(\"  (no wide strings)\")\nEOF"}, "call_id": "call_00_XJtuV4ayIeReX1DtH5671408"}}
