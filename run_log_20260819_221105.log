{"type": "tool_call", "data": {"tool": "bash", "args": {"cmd": "cd /tmp/home_extract; python3 << 'EOF'\n# 逐TCP流提取明文。pcap格式。\n# 手工解析pcap: 全局头24字节 + (packet header 16字节 + packet data)* N\nimport struct\nraw=open('capture.pcap','rb').read()\nmagic=raw[:4]\nprint(\"magic\",magic.hex())\nif magic==b'\\xd4\\xc3\\xb2\\xa1':\n    endian='<'; linktype_fmt='<I'\nelif magic==b'\\xa1\\xb2\\xc3\\xd4':\n    endian='>'; linktype_fmt='>I'\n...\n# 简化：用 big/small 判断\n# 先读linktype\npos=20\nlt=struct.unpack('<I' if magic==b'\\xd4\\xc3\\xb2\\xa1' else '>I', raw[20:24])[0]\nprint(\"linktype\",lt)  # 1=Ethernet\npos=24\ncount=0\ntcp_streams={}\nwhile pos+16<=len(raw):\n    ts_sec,ts_usec,incl,orig=struct.unpack('<IIII', raw[pos:pos+16])\n    pos+=16\n    pkt=raw[pos:pos+incl]\n    pos+=incl\n    count+=1\n    # Ethernet header (14 bytes), if linktype==1\n    if lt==1:\n        eth=pkt[:14]\n        ethertype=struct.unpack('>H',eth[12:14])[0]\n        if ethertype!=0x0800: continue  # IPv4\n        ip=pkt[14:]\n        if len(ip)<20: continue\n        ihl=(ip[0]&0xf)*4\n        proto=ip[9]\n        src=socket.inet_ntoa(ip[12:16]); dst=socket.inet_ntoa(ip[16:20])\n        if proto==6:\n            tcp=ip[ihl:]\n            sport,dport=struct.unpack('>HH',tcp[:4])\n            hlen=(tcp[12]>>4)*4\n            payload=tcp[hlen:]\n            # skip IP/ETH overhead\n            key=(min(src,dst),min(sport,dport),max(sport,dport))\n            tcp_streams.setdefault((src,sport,dst,dport), b'').append(payload)\nimport socket\nprint(\"packets\",count)\n# print stream info\nEOF"}, "call_id": "call_00_BaGuZtaAJ6mrBSP53GRM3374"}}
