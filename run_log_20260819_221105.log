{"type": "tool_call", "data": {"tool": "bash", "args": {"cmd": "cat << 'PYEOF' > /tmp/probe.py\nimport urllib.request, json, re\n\nbase = 'http://10.0.189.131:1337'\n\n# 1. JWKS 端点\nfor p in ['/.well-known/jwks.json', '/jwks.json', '/.well-known/openid-configuration', '/api/v1/jwks']:\n    req = urllib.request.Request(base+p)\n    try:\n        r = urllib.request.urlopen(req, timeout=5)\n        print(f\"{p}: [{r.status}] {r.read()[:300]}\")\n    except urllib.error.HTTPError as e:\n        print(f\"{p}: [{e.code}] {e.read()[:100]}\")\n    except Exception as e:\n        print(f\"{p}: {e}\")\n\n# 2. 首页和 JS\nreq = urllib.request.Request(base+'/')\ntry:\n    r = urllib.request.urlopen(req, timeout=5)\n    html = r.read().decode()\n    print(\"\\n=== index HTML ===\")\n    print(html[:3000])\n    js = re.findall(r'src=\"([^\"]+\\.js)\"', html)\n    print(\"\\nJS files:\", js)\n    # 也找 inline script\n    inline = re.findall(r'<script[^>]*>(.*?)</script>', html, re.S)\n    for i, s in enumerate(inline):\n        if s.strip():\n            print(f\"\\n--- inline script {i} ---\")\n            print(s[:2000])\nexcept Exception as e:\n    print(\"index err:\", e)\nPYEOF\npython3 /tmp/probe.py"}, "call_id": "call_00_b9LuwDXxOShUFiotSkdS1170"}}
