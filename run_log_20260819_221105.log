nwrap();\n    io::stdin().read_line(&mut input).expect(\"Failed to read IP\");\n    match input.trim().parse::<Ipv4Addr>() {\n        Ok(ip) => {\n            let cmd = format!(\"traceroute {}\", ip.to_string());\n   "}}
